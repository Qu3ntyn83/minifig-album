# Beispiel für Caddy: in dein Caddyfile übernehmen und Platzhalter ersetzen.
# Passwort-Hash erzeugen:  docker exec caddy caddy hash-password --plaintext 'DEIN-PASSWORT'
# Danach neu laden:        docker exec caddy caddy reload --config /etc/caddy/Caddyfile
minifigs.example.com {
	basic_auth {
		BENUTZER <HASH-HIER-EINFÜGEN>
	}
	reverse_proxy <SERVER-IP>:3020
}
